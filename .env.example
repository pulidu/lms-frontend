# -----------------------------------------------------------------------------
# LMS Frontend - Environment Variable Reference
# Safe example values only. Copy to `.env.local` for local overrides.
# -----------------------------------------------------------------------------

# API base URL of the LMS backend (origin only - without the `/api` path).
# - Local development: set to a running local backend, e.g. http://localhost:5003,
#   or leave empty to rely on the Vite dev proxy (/api -> http://localhost:5003).
# - Production: full origin of the deployed backend.
VITE_API_BASE_URL=http://localhost:5003

# Optional: Socket.IO server origin for real-time notifications.
# When omitted it falls back to VITE_API_BASE_URL, then to the current window origin.
VITE_SOCKET_URL=http://localhost:5003